<!-- ============================================================================
     Программу разработали: Гарафутдинов А.Р.; Зайнабиддинов И.К.
     =========
     interface3.xaml | ТЕРМИНАЛ №3: ВЫЕЗД.
     Сценарий: водитель подносит карту -> терминал сверяет ЗАЩИЩЁННОЕ время
     с временем оплаты на карте -> "Принято" (шлагбаум) или "Отказано"
     (к терминалу №2). Надпись появляется после поднесения и исчезает сама.
     ============================================================================ -->
<local:KioskWindow x:Class="AvtoParkingKAI.interface3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AvtoParkingKAI"
        mc:Ignorable="d"
        Title="Терминал №3 — Выезд">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- шапка: логотип + флаг -->
        <Grid Grid.Row="0" Margin="20,14,20,0">
            <Image x:Name="imgLogo" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Button x:Name="btnYazyk"
                    Style="{StaticResource HoverScaleButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Padding="12,6"
                    Click="BtnYazyk_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{DynamicResource loc_FlagImage}" Height="22" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource loc_FlagText}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TekstBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Height 620 -> 680: единый запас по вертикали, как в остальных окнах
             (кнопок в центре нет, но флаг-кнопка и общий стиль остаются) -->
        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="30">
            <Grid Width="1280" Height="680">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <!-- приглашение (видно, пока нет карты) -->
                    <TextBlock x:Name="labelPodnesite"
                               Style="{StaticResource ZagolovokStyle}"
                               Text="{DynamicResource loc_PodnesiteKartu}"/>

                    <!-- вердикт: ПРИНЯТО (зелёный) / ОТКАЗАНО (оранжевый) -->
                    <TextBlock x:Name="labelVerdikt"
                               FontSize="86" FontWeight="Bold" TextAlignment="Center"
                               Margin="0,10,0,0" Visibility="Collapsed"/>

                    <!-- пояснение мельче: "к терминалу 2" или "приезжайте ещё" -->
                    <TextBlock x:Name="labelPoyasnenie"
                               FontSize="30" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="1050" Margin="0,26,0,0" Visibility="Collapsed"/>

                    <!-- отсчёт открытого шлагбаума -->
                    <TextBlock x:Name="labelTaymer"
                               Foreground="{StaticResource OzhidanieBrush}"
                               FontSize="34" FontWeight="Bold" TextAlignment="Center"
                               Margin="0,16,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Viewbox>

        <TextBlock Grid.Row="2" Style="{StaticResource KopiraytStyle}" Text="{DynamicResource loc_Copyright}"/>

        <!-- оверлей "сбой времени" -->
        <Border x:Name="overlayVremya" Grid.RowSpan="3" Background="#E61A1D21" Visibility="Collapsed">
            <Border Background="{StaticResource PoverhnostBrush}" CornerRadius="20"
                    BorderBrush="{StaticResource OshibkaBrush}" BorderThickness="3"
                    MaxWidth="1000" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource loc_VremyaBlok}" Foreground="{StaticResource OshibkaBrush}"
                           FontSize="34" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>
        </Border>
    </Grid>
</local:KioskWindow>
