<!-- ============================================================================
     Lang.ru.xaml | Русская локализация терминала.
     Подключается как MergedDictionary и подменяется на лету (DynamicResource).
     Флаг тут АНГЛИЙСКИЙ - потому что кнопка показывает язык, НА который
     переключимся (нажал на британский флаг - получил английский интерфейс).
     Флаги нарисованы прямо в XAML (DrawingImage), чтобы не тащить png в ресурсы.
     ============================================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Упрощённый флаг Великобритании (синий фон + белый/красный кресты) -->
    <DrawingImage x:Key="loc_FlagImage">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 L60,0 60,36 0,36 Z">
                <GeometryDrawing Brush="#012169">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,60,36"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="7"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="60,36"/>
                            <LineGeometry StartPoint="60,0" EndPoint="0,36"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#C8102E" Thickness="3"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="60,36"/>
                            <LineGeometry StartPoint="60,0" EndPoint="0,36"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="12"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="30,0" EndPoint="30,36"/>
                            <LineGeometry StartPoint="0,18" EndPoint="60,18"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#C8102E" Thickness="7"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="30,0" EndPoint="30,36"/>
                            <LineGeometry StartPoint="0,18" EndPoint="60,18"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
