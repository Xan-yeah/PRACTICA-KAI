<!-- ============================================================================
     interface1.xaml | ТЕРМИНАЛ №1: ВЪЕЗД / ВЫДАЧА КАРТЫ-ПРОПУСКА.
     Сценарий: водитель жмёт кнопку -> вставляет USB-"карту" -> на неё пишется
     время заезда -> шлагбаум открыт 15 секунд -> терминал снова готов.
     Кнопки вызова диспетчера тут НЕТ (по ТЗ).
     ============================================================================ -->
<local:KioskWindow x:Class="AvtoParkingKAI.interface1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AvtoParkingKAI"
        mc:Ignorable="d"
        Title="Терминал №1 — Въезд">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- шапка: логотип + флаг -->
        <Grid Grid.Row="0" Margin="20,14,20,0">
            <Image x:Name="imgLogo" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Button x:Name="btnYazyk"
                    Style="{StaticResource HoverScaleButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Padding="12,6"
                    Click="BtnYazyk_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{DynamicResource loc_FlagImage}" Height="22" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource loc_FlagText}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TekstBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Height 620 -> 680: запас по вертикали под рост главной кнопки на 1.2
             (HoverScaleButtonStyle), чтобы её не резало краем Viewbox -->
        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="30">
            <Grid Width="1280" Height="680">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <!-- Цена за час: собрана из Run-ов, чтобы жить при смене языка -->
                    <TextBlock HorizontalAlignment="Center" FontSize="30"
                               Foreground="{StaticResource Tekst2Brush}" Margin="0,0,0,36">
                        <Run Text="{DynamicResource loc_CenaZaChas}"/>
                        <Run x:Name="runCena" Text="200" Foreground="{StaticResource OzhidanieBrush}" FontWeight="Bold"/>
                        <Run Text="{DynamicResource loc_Rub}"/>
                    </TextBlock>

                    <!-- ГЛАВНАЯ КНОПКА (зелёная, огромная - под палец водителя) -->
                    <Button x:Name="btnPoluchit"
                            Style="{StaticResource HoverScaleButtonStyle}"
                            Background="{StaticResource UspehBrush}"
                            Foreground="{StaticResource TemnyTekstBrush}"
                            MinWidth="620" MinHeight="150"
                            FontSize="38"
                            Click="BtnPoluchit_Click">
                        <TextBlock Text="{DynamicResource loc_PoluchitKartu}" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Button>

                    <!-- жёлтое приглашение вставить карту (пока ждём USB) -->
                    <TextBlock x:Name="labelOzhidanie"
                               Text="{DynamicResource loc_OzhidanieKarty}"
                               Foreground="{StaticResource OzhidanieBrush}"
                               FontSize="30" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,34,0,0" Visibility="Collapsed"/>

                    <!-- НЕ ЗАБУДЬТЕ ЗАБРАТЬ КАРТУ - крупнее, чем "проезжайте" (по ТЗ) -->
                    <TextBlock x:Name="labelNeZabudte"
                               Text="{DynamicResource loc_NeZabudte}"
                               Foreground="{StaticResource OshibkaBrush}"
                               FontSize="52" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,30,0,0" Visibility="Collapsed"/>

                    <TextBlock x:Name="labelProezzhayte"
                               Text="{DynamicResource loc_Proezzhayte}"
                               Foreground="{StaticResource UspehBrush}"
                               FontSize="40" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,16,0,0" Visibility="Collapsed"/>

                    <!-- обратный отсчёт до закрытия шлагбаума -->
                    <TextBlock x:Name="labelTaymer"
                               Foreground="{StaticResource OzhidanieBrush}"
                               FontSize="34" FontWeight="Bold" TextAlignment="Center"
                               Margin="0,14,0,0" Visibility="Collapsed"/>

                    <!-- ошибка записи карты. MaxWidth - как у остальных сообщений:
                         без него длинный текст не переносится, а растягивается
                         на всю ширину сетки и выглядит неотцентрованным -->
                    <TextBlock x:Name="labelOshibka"
                               Text="{DynamicResource loc_OshibkaZapisi}"
                               Foreground="{StaticResource OshibkaBrush}"
                               FontSize="30" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="1000" Margin="0,30,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Viewbox>

        <TextBlock Grid.Row="2" Style="{StaticResource KopiraytStyle}" Text="{DynamicResource loc_Copyright}"/>

        <!-- СКРЫТАЯ отладочная кнопка (эмуляция датчика проезда авто):
             невидимый квадрат 80х80 в левом нижнем углу, сбрасывает таймер.
             Background=Transparent обязателен - иначе не ловит нажатия!
             IsTabStop/Focusable=False - чтобы она не попадала ни в Tab, ни в
             навигацию стрелками (KioskWindow.cs) - это служебная кнопка, не для водителя. -->
        <Button x:Name="btnDatchikProezda"
                Grid.RowSpan="3"
                Width="80" Height="80"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="Transparent" BorderBrush="Transparent" Foreground="Transparent"
                IsTabStop="False" Focusable="False"
                Click="BtnDatchikProezda_Click"/>

        <!-- оверлей "сбой времени" -->
        <Border x:Name="overlayVremya" Grid.RowSpan="3" Background="#E61A1D21" Visibility="Collapsed">
            <Border Background="{StaticResource PoverhnostBrush}" CornerRadius="20"
                    BorderBrush="{StaticResource OshibkaBrush}" BorderThickness="3"
                    MaxWidth="1000" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource loc_VremyaBlok}" Foreground="{StaticResource OshibkaBrush}"
                           FontSize="34" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>
        </Border>
    </Grid>
</local:KioskWindow>
