<!-- ============================================================================
     Программу разработали: Гарафутдинов А.Р.; Зайнабиддинов И.К.
     =========
     App.xaml | Точка входа WPF: здесь подключаются общие словари ресурсов
     (палитра + стили кнопок и язык интерфейса) и стартует окно выбора режима.
     ============================================================================ -->
<Application x:Class="AvtoParkingKAI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AvtoParkingKAI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- палитра и фирменные стили -->
                <ResourceDictionary Source="Themes/CommonStyles.xaml"/>
                <!-- язык по умолчанию (при старте подменяется из настроек) -->
                <ResourceDictionary Source="Localization/Lang.ru.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
