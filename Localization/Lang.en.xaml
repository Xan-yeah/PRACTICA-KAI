<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Flag of Russia (white-blue-red tricolor) -->
    <DrawingImage x:Key="loc_FlagImage">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 L60,0 60,36 0,36 Z">
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,60,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0039A6">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,12,60,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#D52B1E">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,24,60,12"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <sys:String x:Key="loc_FlagText">РУ</sys:String>

    <!-- Common -->
    <sys:String x:Key="loc_Copyright">program version 1.0 |©| authors: students of KNRTU-KAI 4110 /JACA/ /YUP/</sys:String>
