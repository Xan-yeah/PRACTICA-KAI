<!-- ============================================================================
     Программу разработали: Гарафутдинов А.Р.; Зайнабиддинов И.К.
     =========
     EditPanel.xaml | РЕЖИМ ОБЛАДАТЕЛЯ.
     Вызывается клавишей "`" ("ё") из любого окна терминала.
     ЕДИНСТВЕННОЕ окно, где ВИДЕН КУРСОР МЫШИ и откуда можно ЗАВЕРШИТЬ программу.

     Четыре панели-состояния в одном окне:
       panelVhod      - ввод пароля (PasswordBox + чекбокс "показать пароль")
       panelSbros     - сброс пароля: логин + код продукта, 4 попытки,
                        блокировка на 5 минут, автоскрытие через 10 секунд
       panelNovyParol - два поля нового пароля + Popup "вы вводите прошлый"
       panelRedakt    - настройки: системное время, цена, M и N минут
     ============================================================================ -->
<Window x:Class="AvtoParkingKAI.EditPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AvtoParkingKAI"
        mc:Ignorable="d"
        Title="Панель обладателя"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        Background="{StaticResource FonBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- шапка: логотип + флаг -->
        <Grid Grid.Row="0" Margin="20,14,20,0">
            <Image x:Name="imgLogo" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Button x:Name="btnYazyk"
                    Style="{StaticResource HoverScaleButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Padding="12,6"
                    Click="BtnYazyk_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{DynamicResource loc_FlagImage}" Height="22" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource loc_FlagText}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TekstBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Height увеличена (640 -> 760 -> 900): panelRedakt пополнилась комбобоксами
             режима терминала и единиц времени + кнопкой смены пароля. Запас по высоте
             нужен ещё и для анимации HoverScaleButtonStyle: выросшая на 1.2 кнопка
             "ЗАВЕРШИТЬ ПРОГРАММУ" в нижнем ряду раньше обрезалась краем Viewbox-а
             (RenderTransform не расширяет layout, Viewbox режет всё за своей границей). -->
        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="30">
            <Grid Width="1280" Height="900">

                <!-- ================= ПАНЕЛЬ 1: ВХОД ================= -->
                <Border x:Name="panelVhod"
                        Background="{StaticResource PoverhnostBrush}"
                        BorderBrush="{StaticResource ObvodkaBrush}" BorderThickness="2"
                        CornerRadius="18" Padding="44" Width="640"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource loc_VhodObladatel}"
                                   Foreground="{StaticResource TekstBrush}"
                                   FontSize="26" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>

                        <!-- пароль: PasswordBox + его "открытый" двойник для чекбокса -->
                        <PasswordBox x:Name="pwdParol"
                                     Style="{StaticResource TerminalPasswordBoxStyle}"
                                     Margin="0,28,0,0" FontSize="24"/>
                        <TextBox x:Name="txtParolVidimy"
                                 Style="{StaticResource TerminalTextBoxStyle}"
                                 Margin="0,28,0,0" FontSize="24" Visibility="Collapsed"/>

                        <CheckBox x:Name="chkPokazatParol"
                                  Style="{StaticResource TerminalCheckBoxStyle}"
                                  Content="{DynamicResource loc_PokazatParol}"
                                  Margin="0,12,0,0"
                                  Checked="ChkPokazatParol_Checked"
                                  Unchecked="ChkPokazatParol_Unchecked"/>

                        <TextBlock x:Name="labelOshibkaVhoda"
                                   Text="{DynamicResource loc_NevernyParol}"
                                   Foreground="{StaticResource OshibkaBrush}"
                                   FontSize="18" TextAlignment="Center" Margin="0,12,0,0"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="labelParolIzmenen"
                                   Text="{DynamicResource loc_ParolIzmenen}"
                                   Foreground="{StaticResource UspehBrush}"
                                   FontSize="18" TextAlignment="Center" Margin="0,12,0,0"
                                   Visibility="Collapsed"/>

                        <Button x:Name="btnVoyti"
                                Style="{StaticResource HoverScaleButtonStyle}"
                                Background="{StaticResource UspehBrush}"
                                Foreground="{StaticResource TemnyTekstBrush}"
                                MinWidth="260" MinHeight="64" Margin="0,22,0,0" FontSize="24"
                                HorizontalAlignment="Center"
                                Click="BtnVoyti_Click">
                            <TextBlock Text="{DynamicResource loc_Voyti}"/>
                        </Button>

                        <!-- "забыли пароль?" - клик мышью или Ctrl+Enter -->
                        <TextBlock x:Name="linkZabyliParol"
                                   Text="{DynamicResource loc_ZabyliParol}"
                                   Foreground="{StaticResource InfoBrush}"
                                   FontSize="18" TextAlignment="Center" Margin="0,18,0,0"
                                   TextDecorations="Underline" Cursor="Hand"
                                   MouseLeftButtonUp="LinkZabyliParol_Click"/>
                    </StackPanel>
                </Border>

                <!-- ================= ПАНЕЛЬ 2: СБРОС ПАРОЛЯ ================= -->
                <Border x:Name="panelSbros"
                        Background="{StaticResource PoverhnostBrush}"
                        BorderBrush="{StaticResource ObvodkaBrush}" BorderThickness="2"
                        CornerRadius="18" Padding="44" Width="700"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource loc_SbrosParolya}"
                                   Foreground="{StaticResource TekstBrush}"
                                   FontSize="26" FontWeight="Bold" TextAlignment="Center"/>

                        <TextBlock Text="{DynamicResource loc_Login}"
                                   Foreground="{StaticResource Tekst2Brush}" FontSize="17" Margin="0,24,0,6"/>
                        <TextBox x:Name="txtLogin"
                                 Style="{StaticResource TerminalTextBoxStyle}" FontSize="22"
                                 PreviewTextInput="TxtLogin_PreviewTextInput"
                                 PreviewKeyDown="ZapretProbela_PreviewKeyDown"/>

                        <!-- подсказка про кириллицу/спецсимволы -->
                        <TextBlock x:Name="labelLoginPodskazka"
                                   Text="{DynamicResource loc_LoginOshibka}"
                                   Foreground="{StaticResource OshibkaBrush}"
                                   FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="Collapsed"/>

                        <TextBlock Text="{DynamicResource loc_KodProdukta}"
                                   Foreground="{StaticResource Tekst2Brush}" FontSize="17" Margin="0,16,0,6"/>
                        <TextBox x:Name="txtKodProdukta"
                                 Style="{StaticResource TerminalTextBoxStyle}" FontSize="22" MaxLength="10"
                                 PreviewTextInput="TxtKodProdukta_PreviewTextInput"
                                 PreviewKeyDown="ZapretProbela_PreviewKeyDown"/>

                        <!-- labelINFO: попытки / таймер блокировки (имя из ТЗ) -->
                        <TextBlock x:Name="labelINFO"
                                   Foreground="{StaticResource OshibkaBrush}"
                                   FontSize="18" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,16,0,0" Visibility="Collapsed"/>

                        <Button x:Name="btnSbrosit"
                                Style="{StaticResource HoverScaleButtonStyle}"
                                Background="{StaticResource OzhidanieBrush}"
                                Foreground="{StaticResource TemnyTekstBrush}"
                                MinWidth="300" MinHeight="64" Margin="0,22,0,0" FontSize="22"
                                HorizontalAlignment="Center"
                                Click="BtnSbrosit_Click">
                            <TextBlock Text="{DynamicResource loc_Sbrosit}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ================= ПАНЕЛЬ 3: НОВЫЙ ПАРОЛЬ ================= -->
                <Border x:Name="panelNovyParol"
                        Background="{StaticResource PoverhnostBrush}"
                        BorderBrush="{StaticResource ObvodkaBrush}" BorderThickness="2"
                        CornerRadius="18" Padding="44" Width="700"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <StackPanel>
                        <!-- имя из ТЗ: labelPasswordINFOedit -->
                        <TextBlock x:Name="labelPasswordINFOedit"
                                   Text="{DynamicResource loc_VvediteNovyParol}"
                                   Foreground="{StaticResource InfoBrush}"
                                   FontSize="26" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>

                        <TextBox x:Name="txtNovyParol1"
                                 Style="{StaticResource TerminalTextBoxStyle}" FontSize="22" Margin="0,26,0,0"/>

                        <TextBlock Text="{DynamicResource loc_PovtoriteParol}"
                                   Foreground="{StaticResource Tekst2Brush}" FontSize="17" Margin="0,16,0,6"/>
                        <TextBox x:Name="txtNovyParol2"
                                 Style="{StaticResource TerminalTextBoxStyle}" FontSize="22"/>

                        <TextBlock x:Name="labelNesovpadenie"
                                   Text="{DynamicResource loc_ParoliNeSovpadayut}"
                                   Foreground="{StaticResource OshibkaBrush}"
                                   FontSize="18" TextAlignment="Center" Margin="0,12,0,0"
                                   Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button x:Name="btnAcceptPassword"
                                    Style="{StaticResource HoverScaleButtonStyle}"
                                    Background="{StaticResource UspehBrush}"
                                    Foreground="{StaticResource TemnyTekstBrush}"
                                    MinWidth="300" MinHeight="64" Margin="10" FontSize="22"
                                    Click="BtnAcceptPassword_Click">
                                <TextBlock Text="{DynamicResource loc_PrinyatParol}"/>
                            </Button>
                            <!-- "Отмена" - раньше пути назад с этой панели не было вовсе -->
                            <Button x:Name="btnOtmenaNovyParol"
                                    Style="{StaticResource HoverScaleButtonStyle}"
                                    MinWidth="220" MinHeight="64" Margin="10" FontSize="22"
                                    Click="BtnOtmenaNovyParol_Click">
                                <TextBlock Text="{DynamicResource loc_Otmena}"/>
                            </Button>
                        </StackPanel>

                        <!-- Popup из ТЗ: попытка поставить СТАРЫЙ пароль как новый -->
                        <Popup x:Name="popupStaryParol"
                               PlacementTarget="{Binding ElementName=txtNovyParol1}"
                               Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
                            <Border Background="{StaticResource OshibkaBrush}" CornerRadius="10"
                                    Padding="16" Margin="6">
                                <TextBlock Text="{DynamicResource loc_StaryParolPopup}"
                                           Foreground="{StaticResource TemnyTekstBrush}"
                                           FontSize="18" FontWeight="Bold"
                                           MaxWidth="520" TextWrapping="Wrap"/>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>

                <!-- ================= ПАНЕЛЬ 4: РЕДАКТИРОВАНИЕ ================= -->
                <Border x:Name="panelRedakt"
                        Background="{StaticResource PoverhnostBrush}"
                        BorderBrush="{StaticResource ObvodkaBrush}" BorderThickness="2"
                        CornerRadius="18" Padding="40" Width="980"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource loc_PanelRedakt}"
                                   Foreground="{StaticResource TekstBrush}"
                                   FontSize="28" FontWeight="Bold" TextAlignment="Center"/>

                        <!-- текущее защищённое время терминала -->
                        <TextBlock HorizontalAlignment="Center" FontSize="22" Margin="0,18,0,0"
                                   Foreground="{StaticResource Tekst2Brush}">
                            <Run Text="{DynamicResource loc_SysVremya}"/>
                            <Run x:Name="runSysVremya" Foreground="{StaticResource OzhidanieBrush}" FontWeight="Bold"/>
                        </TextBlock>

                        <!-- смена системного времени -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="{DynamicResource loc_NovoeVremya}"
                                           Foreground="{StaticResource Tekst2Brush}" FontSize="17" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtNovoeVremya"
                                         Style="{StaticResource TerminalTextBoxStyle}" FontSize="20"/>
                            </StackPanel>
                            <Button x:Name="btnUstanovitVremya" Grid.Column="1"
                                    Style="{StaticResource HoverScaleButtonStyle}"
                                    Background="{StaticResource InfoBrush}"
                                    Foreground="{StaticResource TemnyTekstBrush}"
                                    MinWidth="240" MinHeight="56" FontSize="18" VerticalAlignment="Bottom"
                                    Click="BtnUstanovitVremya_Click">
                                <TextBlock Text="{DynamicResource loc_UstanovitVremya}"/>
                            </Button>
                        </Grid>

                        <!-- цена / M / N -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource loc_CenaChasEdit}"
                                           Foreground="{StaticResource Tekst2Brush}" FontSize="17" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtCena" Style="{StaticResource TerminalTextBoxStyle}" FontSize="20"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{DynamicResource loc_BesplatnoM}"
                                           Foreground="{StaticResource Tekst2Brush}" FontSize="17" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtBesplatnoM" Style="{StaticResource TerminalTextBoxStyle}" FontSize="20"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource loc_VyezdN}"
                                           Foreground="{StaticResource Tekst2Brush}" FontSize="17" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <TextBox x:Name="txtVyezdN" Style="{StaticResource TerminalTextBoxStyle}" FontSize="20"/>
                            </StackPanel>
                        </Grid>

                        <!-- единица измерения времени для M и N: обладателю удобнее
                             задавать большие интервалы в часах, а на демонстрации -
                             короткие в секундах. Хранится числом (0=мин, 1=час, 2=сек),
                             вся математика терминалов переводится в минуты в App -->
                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="{DynamicResource loc_EdinitsaVremeniLabel}"
                                       Foreground="{StaticResource Tekst2Brush}" FontSize="17"
                                       Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <ComboBox x:Name="cmbEdinitsaVremeni"
                                      Style="{StaticResource TerminalComboBoxStyle}">
                                <ComboBoxItem Content="{DynamicResource loc_EdMinuty}"/>
                                <ComboBoxItem Content="{DynamicResource loc_EdChasy}"/>
                                <ComboBoxItem Content="{DynamicResource loc_EdSekundy}"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- вид работы этого терминала: выбор сохраняется вместе с
                             остальными настройками (кнопка "Сохранить" ниже) и включает
                             автозапуск нужного interface при следующем старте программы,
                             минуя окно выбора (см. App.xaml.cs) - удобнее, чем каждый раз
                             настраивать вручную, каким терминалом работает эта ЭВМ -->
                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="{DynamicResource loc_RezhimTerminalaLabel}"
                                       Foreground="{StaticResource Tekst2Brush}" FontSize="17"
                                       Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <ComboBox x:Name="cmbRezhimTerminala"
                                      Style="{StaticResource TerminalComboBoxStyle}">
                                <ComboBoxItem Content="{DynamicResource loc_RezhimSprashivat}"/>
                                <ComboBoxItem Content="{DynamicResource loc_RezhimT1}"/>
                                <ComboBoxItem Content="{DynamicResource loc_RezhimT2}"/>
                                <ComboBoxItem Content="{DynamicResource loc_RezhimT3}"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- строка результата (сохранено / ошибка ввода / время изменено) -->
                        <TextBlock x:Name="labelRezultat"
                                   FontSize="18" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,14,0,0" Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button x:Name="btnSohranit"
                                    Style="{StaticResource HoverScaleButtonStyle}"
                                    Background="{StaticResource UspehBrush}"
                                    Foreground="{StaticResource TemnyTekstBrush}"
                                    MinWidth="280" MinHeight="60" Margin="10" FontSize="19"
                                    Click="BtnSohranit_Click">
                                <TextBlock Text="{DynamicResource loc_Sohranit}"/>
                            </Button>
                            <Button x:Name="btnSozdatDispKey"
                                    Style="{StaticResource HoverScaleButtonStyle}"
                                    Background="{StaticResource InfoBrush}"
                                    Foreground="{StaticResource TemnyTekstBrush}"
                                    MinWidth="280" MinHeight="60" Margin="10" FontSize="19"
                                    Click="BtnSozdatDispKey_Click">
                                <TextBlock Text="{DynamicResource loc_SozdatDispKey}" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button x:Name="btnIzmenitParol"
                                    Style="{StaticResource HoverScaleButtonStyle}"
                                    MinWidth="280" MinHeight="60" Margin="10" FontSize="19"
                                    Click="BtnIzmenitParol_Click">
                                <TextBlock Text="{DynamicResource loc_IzmenitParol}"/>
                            </Button>
                            <Button x:Name="btnVernutsya"
                                    Style="{StaticResource HoverScaleButtonStyle}"
                                    MinWidth="280" MinHeight="60" Margin="10" FontSize="19"
                                    Click="BtnVernutsya_Click">
                                <TextBlock Text="{DynamicResource loc_Vernutsya}"/>
                            </Button>
                        </StackPanel>
                        <!-- нижний Margin 14 - запас под рост кнопки на 1.2 из
                             HoverScaleButtonStyle, чтобы её не резало краем панели -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,14">
                            <!-- ЕДИНСТВЕННАЯ легальная кнопка завершения программы -->
                            <Button x:Name="btnZavershit"
                                    Style="{StaticResource HoverScaleButtonStyle}"
                                    Background="{StaticResource OshibkaBrush}"
                                    Foreground="{StaticResource TemnyTekstBrush}"
                                    MinWidth="280" MinHeight="60" Margin="10" FontSize="19"
                                    Click="BtnZavershit_Click">
                                <TextBlock Text="{DynamicResource loc_Zavershit}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Viewbox>

        <TextBlock Grid.Row="2" Style="{StaticResource KopiraytStyle}" Text="{DynamicResource loc_Copyright}"/>
    </Grid>
</Window>
