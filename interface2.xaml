<!-- ============================================================================
     Программу разработали: Гарафутдинов А.Р.; Зайнабиддинов И.К.
     =========
     interface2.xaml | ТЕРМИНАЛ №2: ОПЛАТА ПАРКОВКИ.
     Сценарий: водитель вставляет карту -> терминал считает стоимость ->
     оплата "через терминал" (эмуляция банка с ProgressBar) или "онлайн"
     (ввод 16 цифр карты). Есть кнопка вызова диспетчера (льготы инвалидам):
     интерфейс блокируется до вставки служебной флешки disp_key.dat.
     ============================================================================ -->
<local:KioskWindow x:Class="AvtoParkingKAI.interface2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AvtoParkingKAI"
        mc:Ignorable="d"
        Title="Терминал №2 — Оплата">

    <!-- локальные стили СВЕТЛОЙ страницы онлайн-оплаты (overlayOnlayn):
         страница стилизована под привычный интернет-банк, поэтому у неё
         своя светлая палитра, а не тёмная палитра терминала -->
    <local:KioskWindow.Resources>
        <Style x:Key="PlatezhPoleStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A1D21"/>
            <Setter Property="CaretBrush" Value="#1A1D21"/>
            <Setter Property="BorderBrush" Value="#C7CDD4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="None"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="ramka"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <!-- рамку при фокусе красит VydelenieService: поле светлое,
                             значит рамка выделения будет тёмной (контраст) -->
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- то же, но для PasswordBox (CVC вводится скрыто, как на реальных страницах) -->
        <Style x:Key="PlatezhParolStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A1D21"/>
            <Setter Property="CaretBrush" Value="#1A1D21"/>
            <Setter Property="BorderBrush" Value="#C7CDD4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="None"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="ramka"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <!-- рамку при фокусе красит VydelenieService: поле светлое,
                             значит рамка выделения будет тёмной (контраст) -->
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- подпись над полем платёжной страницы -->
        <Style x:Key="PlatezhPodpisStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A6572"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </local:KioskWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- шапка: логотип + флаг -->
        <Grid Grid.Row="0" Margin="20,14,20,0">
            <Image x:Name="imgLogo" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Button x:Name="btnYazyk"
                    Style="{StaticResource HoverScaleButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Padding="12,6"
                    Click="BtnYazyk_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{DynamicResource loc_FlagImage}" Height="22" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource loc_FlagText}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TekstBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Height 620 -> 760: добавился информационный блок со счётчиком, а кнопкам
             оплаты нужен запас под рост 1.2 (HoverScaleButtonStyle) - иначе низ
             выросшей кнопки резался бы краем Viewbox -->
        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="30">
            <Grid Width="1280" Height="760">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource ZagolovokStyle}" Text="{DynamicResource loc_OplataParkovki}"/>

                    <!-- РЕЖИМ 1: ждём карту -->
                    <TextBlock x:Name="labelPodnesite"
                               Text="{DynamicResource loc_PodnesiteDlyaRascheta}"
                               Foreground="{StaticResource OzhidanieBrush}"
                               FontSize="30" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="1000" Margin="0,50,0,0"/>

                    <!-- карта не считана -->
                    <TextBlock x:Name="labelKartaBitaya"
                               Text="{DynamicResource loc_KartaNeSchitana}"
                               Foreground="{StaticResource OshibkaBrush}"
                               FontSize="30" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="1000" Margin="0,50,0,0" Visibility="Collapsed"/>

                    <!-- РЕЖИМ 2: карта считана, показываем расчёт -->
                    <StackPanel x:Name="panelRaschet" Visibility="Collapsed" Margin="0,30,0,0">
                        <TextBlock HorizontalAlignment="Center" FontSize="28" Foreground="{StaticResource Tekst2Brush}">
                            <Run Text="{DynamicResource loc_VremyaZaezda}"/>
                            <Run x:Name="runZaezd" Foreground="{StaticResource TekstBrush}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center" FontSize="28" Foreground="{StaticResource Tekst2Brush}" Margin="0,8,0,0">
                            <Run Text="{DynamicResource loc_VremyaStoyanki}"/>
                            <Run x:Name="runStoyanka" Foreground="{StaticResource TekstBrush}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center" FontSize="44" Margin="0,18,0,0" Foreground="{StaticResource TekstBrush}">
                            <Run Text="{DynamicResource loc_KOplate}" FontWeight="Bold"/>
                            <Run x:Name="runSumma" Foreground="{StaticResource OzhidanieBrush}" FontWeight="Bold"/>
                            <Run Text="{DynamicResource loc_Rub}" Foreground="{StaticResource Tekst2Brush}"/>
                        </TextBlock>

                        <!-- статус: бесплатно / уже оплачено / льгота -->
                        <TextBlock x:Name="labelStatus"
                                   Foreground="{StaticResource UspehBrush}"
                                   FontSize="30" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="1000" Margin="0,20,0,0" Visibility="Collapsed"/>

                        <!-- ИНФОРМАЦИОННЫЙ БЛОК: живой счётчик до следующего повышения
                             стоимости + сумма после повышения. Благодаря ему терминал №2
                             работает и как справочный: водитель может просто ПОСМОТРЕТЬ,
                             сколько должен сейчас и сколько будет должен позже, - карта
                             при этом НЕ помечается оплаченной (см. interface2.xaml.cs) -->
                        <Border x:Name="panelInfoBlok"
                                Background="{StaticResource FonBrush}"
                                BorderBrush="{StaticResource ObvodkaBrush}" BorderThickness="2"
                                CornerRadius="14" Padding="30,16"
                                HorizontalAlignment="Center" Margin="0,20,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center" FontSize="24" Foreground="{StaticResource Tekst2Brush}">
                                    <Run x:Name="runInfoPodpis" Text="{DynamicResource loc_DoPovysheniya}"/>
                                    <Run x:Name="runInfoTaymer" Foreground="{StaticResource OzhidanieBrush}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Center" FontSize="22" Foreground="{StaticResource Tekst2Brush}" Margin="0,8,0,0">
                                    <Run Text="{DynamicResource loc_ZatemBudet}"/>
                                    <Run x:Name="runInfoSleduyushaya" Foreground="{StaticResource InfoBrush}" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource loc_Rub}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- два способа оплаты -->
                        <StackPanel x:Name="panelKnopkiOplaty" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                            <Button x:Name="btnOplatitTerminal"
                                    Style="{StaticResource HoverScaleButtonStyle}"
                                    Background="{StaticResource UspehBrush}"
                                    Foreground="{StaticResource TemnyTekstBrush}"
                                    MinWidth="380" MinHeight="100" Margin="16" FontSize="26"
                                    Click="BtnOplatitTerminal_Click">
                                <TextBlock Text="{DynamicResource loc_OplatitTerminal}" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Button>
                            <Button x:Name="btnOplatitOnline"
                                    Style="{StaticResource HoverScaleButtonStyle}"
                                    Background="{StaticResource OzhidanieBrush}"
                                    Foreground="{StaticResource TemnyTekstBrush}"
                                    MinWidth="380" MinHeight="100" Margin="16" FontSize="26"
                                    Click="BtnOplatitOnline_Click">
                                <TextBlock Text="{DynamicResource loc_OplatitOnline}" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Viewbox>

        <!-- вызов диспетчера (голубой #40C4FF по ТЗ) - для льготных категорий -->
        <Button x:Name="btnDispetcher"
                Grid.Row="2"
                Style="{StaticResource HoverScaleButtonStyle}"
                Background="{StaticResource InfoBrush}"
                Foreground="{StaticResource TemnyTekstBrush}"
                HorizontalAlignment="Left" Margin="16,8,0,14"
                MinWidth="260" MinHeight="56" FontSize="20"
                Click="BtnDispetcher_Click">
            <TextBlock Text="{DynamicResource loc_VyzovDisp}"/>
        </Button>

        <TextBlock Grid.Row="2" Style="{StaticResource KopiraytStyle}" Text="{DynamicResource loc_Copyright}"/>

        <!-- ОВЕРЛЕЙ: страница онлайн-оплаты. Стилизована под привычную веб-страницу
             интернет-банка (светлая карточка, псевдо-адресная строка с замочком,
             полный набор реквизитов: номер карты + срок действия + CVC) - по
             требованию UX оплата онлайн выглядит "как в реальности", а не как
             одинокое поле в терминале. Банка и сети по ТЗ нет - страница
             эмулируется локально, после неё запускается прежний "банк" с ProgressBar. -->
        <Border x:Name="overlayOnlayn" Grid.RowSpan="3" Background="#E61A1D21" Visibility="Collapsed">
            <Border Background="#F5F6F8" CornerRadius="14" Width="720"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <!-- псевдо-адресная строка "браузера" -->
                    <Border Background="#E4E7EB" CornerRadius="14,14,0,0" Padding="18,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F512;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="https://pay.kai-parking.ru/secure" Foreground="#5A6572"
                                       FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="44,26,44,34">
                        <TextBlock Text="{DynamicResource loc_OplataOnlaynZagolovok}"
                                   Foreground="#1A1D21" FontSize="26" FontWeight="Bold" TextAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Center" FontSize="20" Foreground="#5A6572" Margin="0,8,0,18">
                            <Run Text="{DynamicResource loc_KOplate}"/>
                            <Run x:Name="runSummaOnlayn" Foreground="#1A1D21" FontWeight="Bold"/>
                            <Run Text="{DynamicResource loc_Rub}"/>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource loc_NomerKartyPole}" Style="{StaticResource PlatezhPodpisStyle}"/>
                        <!-- MaxLength 19 = 16 цифр + 3 пробела-разделителя (автоформат в коде) -->
                        <TextBox x:Name="txtNomerKarty"
                                 Style="{StaticResource PlatezhPoleStyle}"
                                 MaxLength="19" HorizontalContentAlignment="Center"
                                 PreviewTextInput="PoleTolkoTsifry_PreviewTextInput"
                                 TextChanged="TxtNomerKarty_TextChanged"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource loc_SrokPole}" Style="{StaticResource PlatezhPodpisStyle}"/>
                                <!-- MaxLength 5 = ММ/ГГ (косая черта ставится автоформатом) -->
                                <TextBox x:Name="txtSrokKarty"
                                         Style="{StaticResource PlatezhPoleStyle}"
                                         MaxLength="5" HorizontalContentAlignment="Center"
                                         PreviewTextInput="PoleTolkoTsifry_PreviewTextInput"
                                         TextChanged="TxtSrokKarty_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource loc_CvcPole}" Style="{StaticResource PlatezhPodpisStyle}"/>
                                <PasswordBox x:Name="pwdCvc"
                                             Style="{StaticResource PlatezhParolStyle}"
                                             MaxLength="3" HorizontalContentAlignment="Center"
                                             PreviewTextInput="PoleTolkoTsifry_PreviewTextInput"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="labelOshibkaOplaty"
                                   Foreground="{StaticResource OshibkaBrush}"
                                   FontSize="18" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,14,0,0" Visibility="Collapsed"/>

                        <!-- нижний отступ ряда с запасом под рост кнопок 1.2 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,6">
                            <Button x:Name="btnOplatitOnlineOk"
                                    Style="{StaticResource HoverScaleButtonStyle}"
                                    Background="{StaticResource UspehBrush}"
                                    Foreground="{StaticResource TemnyTekstBrush}"
                                    MinWidth="240" MinHeight="64" Margin="10" FontSize="24"
                                    Click="BtnOplatitOnlineOk_Click">
                                <TextBlock Text="{DynamicResource loc_Oplatit}"/>
                            </Button>
                            <Button x:Name="btnOtmenaOnlayn"
                                    Style="{StaticResource HoverScaleButtonStyle}"
                                    Background="#E4E7EB"
                                    Foreground="#1A1D21"
                                    MinWidth="200" MinHeight="64" Margin="10" FontSize="24"
                                    Click="BtnOtmenaOnlayn_Click">
                                <TextBlock Text="{DynamicResource loc_Otmena}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ОВЕРЛЕЙ: эмуляция банка (модально, поверх всего) -->
        <Border x:Name="overlayBank" Grid.RowSpan="3" Background="#E61A1D21" Visibility="Collapsed">
            <Grid>
                <!-- ВАРИАНТ А: ОПЛАТА ЧЕРЕЗ ТЕРМИНАЛ (тёмный POS-стиль, зелёный акцент) -->
                <Border x:Name="panelBankTerminal"
                        Background="{StaticResource PoverhnostBrush}" CornerRadius="20"
                        BorderBrush="{StaticResource UspehBrush}" BorderThickness="3"
                        MinWidth="640" Padding="46" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="&#x1F4B3;" FontSize="56" TextAlignment="Center"/>
                        <TextBlock x:Name="labelBankStatusTerminal"
                                   Text="{DynamicResource loc_Soedinenie}"
                                   Foreground="{StaticResource OzhidanieBrush}"
                                   FontSize="32" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="760" Margin="0,18,0,0"/>
                        <!-- сегментная шкала: ячейки создаёт код, тут только контейнер -->
                        <StackPanel x:Name="panelSegmenty" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,28,0,0"/>
                        <TextBlock x:Name="labelProcentTerminal"
                                   Foreground="{StaticResource Tekst2Brush}"
                                   FontSize="22" FontWeight="Bold" TextAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ВАРИАНТ Б: ОПЛАТА ОНЛАЙН (светлый веб-стиль, как overlayOnlayn) -->
                <Border x:Name="panelBankOnlayn"
                        Background="#F5F6F8" CornerRadius="14" Width="560"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                    <StackPanel>
                        <!-- псевдо-адресная строка "браузера" - продолжение страницы оплаты -->
                        <Border Background="#E4E7EB" CornerRadius="14,14,0,0" Padding="18,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F512;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="https://pay.kai-parking.ru/processing" Foreground="#5A6572"
                                           FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="40,34,40,38">
                            <!-- круговой спиннер: серое кольцо-подложка + синяя дуга,
                                 которую код крутит вокруг центра (RotateTransform).
                                 Canvas нужен, чтобы RenderTransformOrigin 0.5/0.5
                                 совпадал с центром ОКРУЖНОСТИ, а не с центром
                                 прямоугольника самой дуги -->
                            <Grid Width="130" Height="130" HorizontalAlignment="Center">
                                <Ellipse Stroke="#E4E7EB" StrokeThickness="10" Margin="5"/>
                                <Canvas Width="130" Height="130" RenderTransformOrigin="0.5,0.5">
                                    <Canvas.RenderTransform>
                                        <RotateTransform x:Name="spinnerPovorot"/>
                                    </Canvas.RenderTransform>
                                    <Path x:Name="spinnerDuga" Stroke="#2962FF" StrokeThickness="10"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 65,10 A 55,55 0 0 1 120,65"/>
                                </Canvas>
                                <TextBlock x:Name="labelProcentOnlayn"
                                           Foreground="#1A1D21" FontSize="26" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="labelBankStatusOnlayn"
                                       Text="{DynamicResource loc_ObrabotkaPlatezha}"
                                       Foreground="#5A6572"
                                       FontSize="24" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,24,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ОВЕРЛЕЙ: диспетчер вызван - интерфейс заблокирован до его флешки -->
        <Border x:Name="overlayDispetcher" Grid.RowSpan="3" Background="#E61A1D21" Visibility="Collapsed">
            <Border Background="{StaticResource PoverhnostBrush}" CornerRadius="20"
                    BorderBrush="{StaticResource InfoBrush}" BorderThickness="3"
                    MaxWidth="1000" Padding="46" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="labelDispStatus"
                           Text="{DynamicResource loc_DispVyzvan}"
                           Foreground="{StaticResource InfoBrush}"
                           FontSize="34" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>
        </Border>

        <!-- оверлей "сбой времени" -->
        <Border x:Name="overlayVremya" Grid.RowSpan="3" Background="#E61A1D21" Visibility="Collapsed">
            <Border Background="{StaticResource PoverhnostBrush}" CornerRadius="20"
                    BorderBrush="{StaticResource OshibkaBrush}" BorderThickness="3"
                    MaxWidth="1000" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource loc_VremyaBlok}" Foreground="{StaticResource OshibkaBrush}"
                           FontSize="34" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>
        </Border>
    </Grid>
</local:KioskWindow>
